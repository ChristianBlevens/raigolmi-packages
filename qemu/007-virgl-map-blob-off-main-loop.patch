+/*
+ * virgl_renderer_resource_map() can take tens of milliseconds (Venus on
+ * Windows imports the blob's memory into a VkDevice of its own and maps it
+ * there). On the main loop that stops every timer, the sound card's among
+ * them, so it runs on map_thread. The command queue stays blocked meanwhile,
+ * so no other virglrenderer call touches the resource being mapped.
+ */
+static void virtio_gpu_virgl_map_run(VirtIOGPUGL *gl)
+{
+    int64_t start = get_clock();
+
+    gl->map_ret = virgl_renderer_resource_map(gl->map_resource_id,
+                                              &gl->map_data, &gl->map_size);
+    gl->map_ns = get_clock() - start;
+}
+
+static void *virtio_gpu_virgl_map_thread(void *opaque)
+{
+    VirtIOGPUGL *gl = opaque;
+
+    virtio_gpu_virgl_map_run(gl);
+    qatomic_store_release(&gl->map_finished, true);
+    qemu_bh_schedule(gl->map_done_bh);
+    return NULL;
+}
+
+static void virtio_gpu_virgl_map_join(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    qemu_thread_join(&gl->map_thread);
+    gl->map_running = false;
+    VIRTIO_GPU_BASE(g)->renderer_blocked--;
+}
+
+/* Back on the main loop: the suspended MAP_BLOB is processed again. */
+static void virtio_gpu_virgl_map_done_bh(void *opaque)
+{
+    VirtIOGPU *g = opaque;
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    /* A reset may have joined it already, and a later map may be running. */
+    if (!gl->map_running || !qatomic_load_acquire(&gl->map_finished)) {
+        return;
+    }
+    virtio_gpu_virgl_map_join(g);
+    qemu_bh_schedule(gl->cmdq_resume_bh);
+}
+
+/*
+ * A resource destroyed while its map is in flight (only a device reset does
+ * that, the command queue being blocked) waits for the map and undoes it.
+ */
+static void virtio_gpu_virgl_map_cancel(VirtIOGPU *g,
+                                        struct virtio_gpu_virgl_resource *res)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (gl->map_resource_id != res->base.resource_id) {
+        return;
+    }
+    if (gl->map_running) {
+        virtio_gpu_virgl_map_join(g);
+    }
+    if (gl->map_ret == 0) {
+        virgl_renderer_resource_unmap(res->base.resource_id);
+    }
+    gl->map_resource_id = 0;
+}
