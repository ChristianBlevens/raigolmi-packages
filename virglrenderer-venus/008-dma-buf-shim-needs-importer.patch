+/* Whether vrend_renderer_pipe_resource_set_type below has a route that imports a dma-buf:
+ * with EGL, an EGLImage, which needs GBM; without EGL, a GL memory object. Windows builds
+ * never have GBM (meson.build), so there an EGL-backed vrend imports none.
+ */
+bool
+vrend_renderer_imports_dma_buf(void)
+{
+#ifdef HAVE_EPOXY_EGL_H
+   if (egl) {
+#ifdef ENABLE_GBM
+      return true;
+#else
+      return false;
+#endif
+   }
+#endif
+#ifdef _WIN32
+   return has_feature(feat_memory_object) && has_feature(feat_memory_object_win32);
+#else
+   return has_feature(feat_memory_object) && has_feature(feat_memory_object_fd);
+#endif
+}
