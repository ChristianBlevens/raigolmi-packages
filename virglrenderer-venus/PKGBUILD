# virglrenderer with Venus (Vulkan over virtio-gpu) on Windows, from the winq-emu fork, with a
# copy of the patched QEMU beside it in ${MINGW_PREFIX}/raigolmi-venus. QEMU imports
# libvirglrenderer-1.dll by name, and Windows looks in the exe's own directory before PATH, so
# this exe runs on the fork's DLL while ${MINGW_PREFIX}/bin keeps the stock one. The directory
# sits one level under the prefix, as bin does: QEMU finds share/qemu as <exe dir>/../share/qemu
# (util/cutils.c get_relocated_path).

_realname=virglrenderer-venus
pkgbase=mingw-w64-${_realname}
pkgname=${MINGW_PACKAGE_PREFIX}-${_realname}
_commit=e80354b8f5a0dedc62374b905a181874682659cc
# The QEMU release whose qemu-system-x86_64w.exe this package carries; the exe needs that
# release's share/qemu and DLLs, so the package depends on exactly it.
_qemu=11.1.1-3.4
pkgver=1.3.0.e80354b8
pkgrel=10
pkgdesc='virglrenderer with Venus from the winq-emu fork, and the patched QEMU that loads it, for RaiGolmi (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/cmspam/winq-emu-virglrenderer'
license=('spdx:MIT AND GPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-2-Clause AND BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-libepoxy"
         "${MINGW_PACKAGE_PREFIX}-libwinpthread"
         "${MINGW_PACKAGE_PREFIX}-qemu=${_qemu}")
# Vulkan itself is loaded at run time (vulkan-dload, src/venus/vkr_library.c): vulkan-1.dll from
# the GPU driver in System32.
makedepends=("git"
             "${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-meson"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python-yaml"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-vulkan-headers")
# The exe is copied byte for byte; makepkg's strip would rewrite it.
options=('!strip')
source=("virglrenderer::git+https://github.com/cmspam/winq-emu-virglrenderer.git#commit=${_commit}"
        "https://github.com/ChristianBlevens/raigolmi-packages/releases/download/qemu-${_qemu}/${MINGW_PACKAGE_PREFIX}-qemu-${_qemu}-any.pkg.tar.zst"
        001-void-param.patch
        003-d3d11-texture-optional.patch
        004-venus-failure-log.patch
        005-eventfd-handle.patch
        006-cursor-top-down.patch
        007-vrend-no-sync-thread.patch
        008-dma-buf-shim-needs-importer.patch
        009-proxy-failed-blob-reply.patch
        010-venus-import-handle-close.patch
        011-proxy-worker-teardown.patch)
sha256sums=('SKIP'
            '772ebea5811df0dd0a723100de715790afe3e326b6c08b217ad0cdb9af1187db'
            '234e25bdbc7bd40aad1af995d2186cf019ea48e6d3e4bbc3473efa0fc67d039c'
            '3be48b5da58399eb545b18f09bfe3e58010576a4f7259fee98b693314ec08dbd'
            'f90506db6276a312c36fe1665899334b358fc0852267f85217e6e1d6d4753dca'
            '157fc88dbe5631ca6aa602210fbc25bcb83478997f80a8a1416f036844d90578'
            'a632b86440025cd8de5517436184c4605a80b5c476d3b995884599809a1672aa'
            '9ede92204c814fd42e1fbf7c0842acf457e73f3b9882f7c7f38e850e1af49bcf'
            '3ff2b312b5784e22fb8075a42c947a533d0d4d642abd0e22b3f5bb97abf784b2'
            '2d44e14a8a2b3578fdcbefe164f9d0c163d518dae104dbf66b4f713c7126e80c'
            'b76d3995310107082c981a9fc881bc340ee9ba6d3752c8eaa2353d63bb89f6bc'
            'd81af6cfb58b026ce5b796f29ce745340982fc1c0405500582f8905d44ce4c17')
noextract=("${MINGW_PACKAGE_PREFIX}-qemu-${_qemu}-any.pkg.tar.zst")

# MSYS2's 002-no-ioccom.patch is not here: the fork's drm.h has its own _WIN32 branch.
prepare() {
  cd virglrenderer
  patch -Nbp1 -i "${srcdir}/001-void-param.patch"
  patch -Nbp1 -i "${srcdir}/003-d3d11-texture-optional.patch"
  patch -Nbp1 -i "${srcdir}/004-venus-failure-log.patch"
  patch -Nbp1 -i "${srcdir}/005-eventfd-handle.patch"
  patch -Nbp1 -i "${srcdir}/006-cursor-top-down.patch"
  patch -Nbp1 -i "${srcdir}/007-vrend-no-sync-thread.patch"
  patch -Nbp1 -i "${srcdir}/008-dma-buf-shim-needs-importer.patch"
  patch -Nbp1 -i "${srcdir}/009-proxy-failed-blob-reply.patch"
  patch -Nbp1 -i "${srcdir}/010-venus-import-handle-close.patch"
  patch -Nbp1 -i "${srcdir}/011-proxy-worker-teardown.patch"
}

build() {
  mkdir -p build-${MSYSTEM} && cd build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="--prefix" \
  ${MINGW_PREFIX}/bin/meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=release \
    --wrap-mode=nodownload \
    -Dvenus=true \
    -Dvideo=false \
    ../virglrenderer

  ${MINGW_PREFIX}/bin/meson compile
}

package() {
  local dir="${pkgdir}${MINGW_PREFIX}/raigolmi-venus"

  # Staged, so only the DLL reaches the package: the headers and pkg-config file stay the
  # stock package's.
  cd build-${MSYSTEM}
  DESTDIR="${srcdir}/stage" ${MINGW_PREFIX}/bin/meson install --strip
  install -D -m755 "${srcdir}/stage${MINGW_PREFIX}/bin/libvirglrenderer-1.dll" "${dir}/libvirglrenderer-1.dll"

  bsdtar -xOf "${srcdir}/${MINGW_PACKAGE_PREFIX}-qemu-${_qemu}-any.pkg.tar.zst" \
    "${MINGW_PREFIX#/}/bin/qemu-system-x86_64w.exe" > "${dir}/qemu-system-x86_64w.exe"
  chmod 755 "${dir}/qemu-system-x86_64w.exe"

  install -D -m644 "${srcdir}/virglrenderer/COPYING" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
