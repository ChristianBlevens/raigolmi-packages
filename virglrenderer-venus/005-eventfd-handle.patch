@@ -163,6 +155,22 @@
 #endif
 }
 
+void close_eventfd(int fd)
+{
+#ifdef _WIN32
+   CloseHandle(eventfd_handle(fd));
+#else
+   close(fd);
+#endif
+}
+
+#ifdef _WIN32
+void *eventfd_handle(int fd)
+{
+   return LongToHandle(fd);
+}
+#endif
