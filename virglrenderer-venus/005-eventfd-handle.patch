diff --git a/src/virgl_util.h b/src/virgl_util.h
--- a/src/virgl_util.h
+++ b/src/virgl_util.h
@@ -65,10 +65,19 @@
 
 bool equal_func(const void *key1, const void *key2);
 
+/* On Windows an eventfd is a manual-reset event's HANDLE value, not a CRT fd: the CRT
+ * cannot wrap an event (_open_osfhandle needs a file type, GetFileType fails on events with
+ * ERROR_INVALID_HANDLE), and handle values fit in an int (HandleToLong). Only the functions
+ * below use or close it; virgl_renderer_get_poll_fd hands out the same value.
+ */
 bool has_eventfd(void);
 int create_eventfd(unsigned int initval);
 int write_eventfd(int fd, uint64_t val);
 void flush_eventfd(int fd);
+void close_eventfd(int fd);
+#ifdef _WIN32
+void *eventfd_handle(int fd);
+#endif
 
