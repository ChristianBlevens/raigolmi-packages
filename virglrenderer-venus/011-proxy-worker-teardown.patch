+/*
+ * Tears down a worker already unlinked from state->workers. The join runs without
+ * workers_mutex: the worker's context teardown retires fences through
+ * server_retire_fence_cb, which takes it. The socket and fence event are closed only after
+ * the join, so their values cannot be reused while the worker or that callback holds them.
+ */
 static void
-server_destroy_worker(struct server_thread_state *state,
-                      struct server_context_worker *w)
+server_destroy_worker(struct server_context_worker *w)
 {
-   /* Close our end; worker thread will exit when recv fails */
-   closesocket((SOCKET)w->socket_fd);
+   /* Ends the worker's recv. */
+   shutdown((SOCKET)w->socket_fd, SD_BOTH);
    thrd_join(w->thread, NULL);
 
-   list_del(&w->head);
+   closesocket((SOCKET)w->socket_fd);
+   if (w->fence_eventfd >= 0)
+      close_eventfd(w->fence_eventfd);
    free(w);
 }
 
+static void
+server_destroy_all_workers(struct server_thread_state *state)
+{
+   while (true) {
+      mtx_lock(&state->workers_mutex);
+      struct server_context_worker *w = NULL;
+      if (!list_is_empty(&state->workers)) {
+         w = list_first_entry(&state->workers, struct server_context_worker, head);
+         list_del(&w->head);
+      }
+      mtx_unlock(&state->workers_mutex);
+
+      if (!w)
+         break;
+      server_destroy_worker(w);
+   }
+}
